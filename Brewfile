# Minimal cross-platform package list for dotfiles repo
# Managed by this repository's Makefile
# Install with: brew bundle --file=Brewfile

# Core tools managed by this dotfiles repo
brew "git"
brew "neovim"
brew "tmux"
brew "stow"
brew "zsh"

# Direct dependencies used by shell/editor config
brew "fzf"       # Fuzzy finder (used in zsh keybindings, nvim telescope)
brew "ripgrep"   # Fast search (used by nvim telescope)
brew "bat"       # Syntax-highlighted cat (shell workflow)
