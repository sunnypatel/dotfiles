###############################################################################
# .zimrc - Zimfw Module Configuration
###############################################################################
# Purpose: Define which Zimfw modules to load
# Source: https://zimfw.sh/docs/modules/
#
# Module loading order matters:
# - Core modules (environment, input, utility) first
# - Modules that add completions before 'completion' module
# - Completion module near end (after modules that add completion defs)
# - Syntax highlighting must be last
###############################################################################

#
# Core Modules - Sane Defaults
#

# Sets sane Zsh built-in environment options
# Provides: AUTO_CD, INTERACTIVE_COMMENTS, proper globbing, etc.
zmodule environment

# Applies correct bindkeys for input events
# Provides: Home, End, Delete, Insert, arrow keys, etc.
zmodule input

# Utility aliases and functions
# Provides: ls colors, grep colors, less defaults, chmod shortcuts
zmodule utility

#
# Git Integration
#

# Git aliases and functions
# Provides: g, ga, gc, gco, gd, etc. + git utility functions
zmodule git

#
# Prompt Modules
#

# Exposes how long the last command took to execute
# Used by asciiship prompt module
zmodule duration-info

# Exposes git repository status information to prompts
# Used by asciiship prompt module
zmodule git-info

# A heavily reduced, ASCII-only version of Spaceship/Starship prompts
# Lightweight, fast, displays git status and command duration
zmodule asciiship

#
# Completion System
#

# Additional completion definitions for Zsh
# Adds completions for common tools (docker, npm, git, etc.)
zmodule zsh-users/zsh-completions --fpath src

# Tab completion - enables and configures Zsh completion system
# MUST be after all modules that add completion definitions
# Handles compinit with proper caching for fast startup
zmodule completion

#
# Interactive Enhancements
#

# Fish-like syntax highlighting for Zsh
# Highlights commands as you type (green = valid, red = invalid)
# MUST be after completion module
zmodule zsh-users/zsh-syntax-highlighting

# Fish-like autosuggestions for Zsh
# Suggests commands from history as you type (gray text)
# Accept with right arrow or Ctrl+F
zmodule zsh-users/zsh-autosuggestions
