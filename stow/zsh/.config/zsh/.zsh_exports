###############################################################################
# .zsh_exports - Non-Secret Environment Variables
###############################################################################
# Sourced by: .zshenv (available to all shells, including scripts)
# Purpose: Tool configs, app settings, and other non-sensitive exports
# For secrets (API keys, tokens), use .zsh_secrets instead
