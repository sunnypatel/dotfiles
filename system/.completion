# Bash completion (only load in bash, zsh uses its own completion system)

if [ -n "$BASH_VERSION" ]; then
  if is-executable brew; then
    BREW_PREFIX=$(brew --prefix)
    [ -f "$BREW_PREFIX/share/bash-completion/bash_completion" ] && . "$BREW_PREFIX/share/bash-completion/bash_completion"
  elif [ -f /usr/share/bash-completion/bash_completion ]; then
    . /usr/share/bash-completion/bash_completion
  elif [ -f /etc/bash_completion ]; then
    . /etc/bash_completion
  fi

  # Dotfiles bash completion

  _dotfiles_completions() {
    local cur="${COMP_WORDS[COMP_CWORD]}"
    COMPREPLY=( $(compgen -W 'clean dock duti edit help macos test update' -- $cur ) );
  }

  complete -o default -F _dotfiles_completions dot

  # tmux

  if is-executable brew && [ -f "$BREW_PREFIX/etc/bash_completion.d/tmux" ]; then
    . "$BREW_PREFIX/etc/bash-completion.d/tmux"
  fi

  # pnpm completion - use cache for speed (saves ~0.7s)
  # Regenerate cache with: pnpm completion bash > ~/.cache/pnpm-completion.bash
  PNPM_COMPLETION_CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/pnpm-completion.bash"
  if [ -f "$PNPM_COMPLETION_CACHE" ]; then
    . "$PNPM_COMPLETION_CACHE"
  elif is-executable pnpm; then
    # Generate cache on first run
    mkdir -p "$(dirname "$PNPM_COMPLETION_CACHE")"
    pnpm completion bash > "$PNPM_COMPLETION_CACHE" 2>/dev/null
    . "$PNPM_COMPLETION_CACHE"
  fi

  # Git

  if is-executable git; then
    if [ -n "$BREW_PREFIX" ] && [ -f "$BREW_PREFIX/etc/bash-completion.d/git-completion.bash" ]; then
      . "$BREW_PREFIX/etc/bash-completion.d/git-completion.bash"
    elif [ -f /usr/share/bash-completion/completions/git ]; then
      . /usr/share/bash-completion/completions/git
    fi
  fi
fi
