export NVM_DIR="$HOME/.nvm"

# LAZY LOAD NVM - Only load when actually needed
# This saves ~1.5s on every shell startup

if [ -s "$NVM_DIR/nvm.sh" ]; then
  # Add default node to PATH immediately (without loading nvm)
  # First try to find the resolved version
  if [ -f "$NVM_DIR/alias/default" ]; then
    DEFAULT_ALIAS=$(cat "$NVM_DIR/alias/default" 2>/dev/null)
    # If it's an lts alias, try to find the resolved version
    if [[ "$DEFAULT_ALIAS" == lts/* ]]; then
      LTS_NAME="${DEFAULT_ALIAS#lts/}"
      # Find the actual version from the lts alias
      if [ -f "$NVM_DIR/alias/lts/$LTS_NAME" ]; then
        NODE_VERSION=$(cat "$NVM_DIR/alias/lts/$LTS_NAME" 2>/dev/null)
      fi
    else
      NODE_VERSION="$DEFAULT_ALIAS"
    fi
  fi
  
  # Add node bin to PATH if we found a version
  if [ -n "$NODE_VERSION" ] && [ -d "$NVM_DIR/versions/node/$NODE_VERSION/bin" ]; then
    export PATH="$NVM_DIR/versions/node/$NODE_VERSION/bin:$PATH"
  else
    # Fallback: find most recent node version
    NODE_VERSION=$(ls -v "$NVM_DIR/versions/node" 2>/dev/null | tail -1)
    if [ -n "$NODE_VERSION" ] && [ -d "$NVM_DIR/versions/node/$NODE_VERSION/bin" ]; then
      export PATH="$NVM_DIR/versions/node/$NODE_VERSION/bin:$PATH"
    fi
  fi

  # Lazy load nvm - only load when 'nvm' command is actually called
  nvm() {
    unset -f nvm node npm npx
    \. "$NVM_DIR/nvm.sh"
    nvm "$@"
  }
fi
